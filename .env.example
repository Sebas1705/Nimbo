# Copy to .env (git ignores it) and uncomment what you need. Everything is optional.

# Host port the UI is published on (always on 127.0.0.1).
# NIMBO_PORT=8080

# Image tag to run: a version such as 0.1.0, or latest.
# NIMBO_VERSION=latest

# If set, every API call needs "Authorization: Bearer <token>" and the UI asks for it once.
# Generate one with: openssl rand -hex 24
# NIMBO_API_TOKEN=

# Credentials for the providers that need them. Without them MinIO and PostgreSQL refuse to start
# and tell you which variable is missing. Use throwaway values: these are local emulators.
# NIMBO_MINIO_USER=nimbo
# NIMBO_MINIO_PASSWORD=
# NIMBO_POSTGRES_PASSWORD=

# Extra Host header values to accept besides localhost, comma separated (only if you put your own
# reverse proxy in front).
# NIMBO_ALLOWED_HOSTS=

# With Doppler instead of a .env file:  doppler run -- docker compose up -d
